---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import FancyBar from '../components/FancyBar.astro';
import Nav from '../components/Nav.astro';
import Tag from '../components/Tag.astro';
import ButtonGroup from '../components/ButtonGroup.astro';
import Button from '../components/Button.astro';
import RelatedCard from '../components/feed/RelatedCard.astro';
import CroppedInfographic from '../components/CroppedInfographic.astro';
import SiteFooter from '../components/feed/SiteFooter.astro';
import ArrowLeftIcon from '../components/icons/ArrowLeftIcon.astro';
import { chapterName } from '../data/chapters';
import { getFlatInfographics } from '../data/infographics';
import { imgUrl } from '../utils/img';
import { absoluteUrl } from '../utils/seo';
import site from '../data/site.json';
import seo from '../data/seo.json';
import { ui } from '../data/ui';

export async function getStaticPaths() {
  const flat = await getFlatInfographics();

  const entries = await getCollection('infographics');
  const entryBySlug = new Map<string, (typeof entries)[number]>(
    entries.map((e) => [e.id, e])
  );

  return flat.map((item, i) => {
    const entry = entryBySlug.get(item.slug)!;
    const prev = flat[(i - 1 + flat.length) % flat.length];
    const next = flat[(i + 1) % flat.length];

    return { params: { slug: item.slug }, props: { entry, prev, next } };
  });
}

const { entry, prev, next } = Astro.props;
const data = entry.data;
const { Content } = await render(entry);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = data.title;
const lead = data.lead;
const chapterLabel = chapterName(data.chapter);
const imgSrc = imgUrl(data.image);

const downloads = (data.downloads ?? [])
  .filter((path) => path)
  .map((path) => ({
    href: path.startsWith('/') ? `${base}${path}` : path,
    label: (path.split('.').pop() || '').toUpperCase(),
  }));
const tableUrl = data.data?.tableUrl || null;
// Data sources, one row each. Entries written the old way (sourceUrl +
// citation) collapse into a single row so nothing disappears.
const sources =
  data.data?.sources ??
  (data.data?.sourceUrl || data.data?.citation
    ? [{ label: data.data?.citation || data.data?.sourceUrl!, url: data.data?.sourceUrl }]
    : []);
const hasUnderlyingData = Boolean(tableUrl) || sources.length > 0;

const href = (slug: string) => `${base}/${slug}/`;

const pageUrl = absoluteUrl(Astro.site, `${base}/${entry.id}/`);
const imageUrl = absoluteUrl(Astro.site, imgSrc);
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ImageObject',
      contentUrl: imageUrl,
      url: imageUrl,
      name: title,
      description: lead,
      representativeOfPage: true,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: seo.siteTitle, item: absoluteUrl(Astro.site, `${base}/`) },
        { '@type': 'ListItem', position: 2, name: chapterLabel },
        { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
      ],
    },
  ],
};
---

<Layout title={`${title} — ${seo.siteTitle}`} description={lead} image={data.image} type="article">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <FancyBar />
  <Nav compact siblings={site.languages} atlasPdfUrl={site.atlasPdfUrl} />

  <!-- Fixed split background (same as the feed). -->
  <div class="detail-bg" aria-hidden="true">
    <div class="detail-bg__fill detail-bg__fill--left"></div>
    <div class="detail-bg__center">
      <div class="detail-bg__col detail-bg__col--sidebar"></div>
      <div class="detail-bg__col detail-bg__col--content"></div>
    </div>
    <div class="detail-bg__fill detail-bg__fill--right"></div>
  </div>

  <div class="detail">
    <div class="detail__spacer"></div>

    <div class="detail__center">
      <div class="detail__main">
        <aside class="detail__sidebar-col">
          <div class="detail__sidebar-sticky">
            <div class="meta" data-meta-root>
              <section class="meta__block" data-meta="related">
                <div class="meta__related-item">
                  <h2 class="meta__label type-eyebrow">{ui.detail.nextInfographic}</h2>
                  <div class="meta__related">
                    <RelatedCard title={next.title} image={next.image} href={href(next.slug)} />
                  </div>
                </div>
                <div class="meta__related-item">
                  <h2 class="meta__label type-eyebrow">{ui.detail.previousInfographic}</h2>
                  <div class="meta__related">
                    <RelatedCard title={prev.title} image={prev.image} href={href(prev.slug)} />
                  </div>
                </div>
              </section>

              {hasUnderlyingData && (
                <section class="meta__block" data-meta="data">
                  <h2 class="meta__label type-eyebrow">{ui.detail.underlyingData}</h2>
                  <ul class="meta__sources">
                    {tableUrl && (
                      <li class="meta__source-item type-small">
                        <a href={tableUrl} target="_blank" rel="noopener noreferrer">
                          <i class="fa-solid fa-table" aria-hidden="true"></i>
                          <span>{ui.detail.dataTable}</span>
                        </a>
                      </li>
                    )}
                    {sources.map((s) => (
                      <li class="meta__source-item type-small">
                        {s.url ? (
                          <a href={s.url} target="_blank" rel="noopener noreferrer">
                            <i class="fa-solid fa-file-lines" aria-hidden="true"></i>
                            <span>{s.label}</span>
                          </a>
                        ) : (
                          <span class="meta__source-plain">
                            <i class="fa-solid fa-file-lines" aria-hidden="true"></i>
                            <span>{s.label}</span>
                          </span>
                        )}
                      </li>
                    ))}
                  </ul>
                </section>
              )}

              {downloads.length > 0 && (
                <section class="meta__block" data-meta="download">
                  <h2 class="meta__label type-eyebrow">{ui.detail.download}</h2>
                  <ButtonGroup direction="row">
                    {downloads.map((d) => (
                      <Button variant="text" href={d.href} download>{d.label}</Button>
                    ))}
                  </ButtonGroup>
                </section>
              )}
            </div>
          </div>
        </aside>

        <main class="detail__content" id="main-content">
          <div class="detail__hero">
            <div class="detail__hero-inner">
              <div class="detail__back">
                <Button variant="text" href={`${base}/#${entry.id}`}>
                  <ArrowLeftIcon slot="icon-left" size={16} />
                  {ui.detail.back}
                </Button>
              </div>
              <div class="detail__titles">
                <h1 class="detail__title type-title">{title}</h1>
                <p class="detail__lead type-lead">{lead}</p>
              </div>
              <div class="detail__media">
                <CroppedInfographic src={imgSrc} alt={title} loading="eager" />
              </div>
            </div>
          </div>

          <div class="detail__body">
            <div class="detail__prose">
              <Content />
            </div>
          </div>

          <!-- Small screens (≤ --bp-lg): the sidebar's Next/Previous block
               relocates here, at the end of the article. -->
          <div class="detail__end-meta" data-end-meta></div>

          <!-- Small screens: the sidebar's Underlying data + Download blocks
               relocate here, below Next/Previous. -->
          <div class="detail__inline-meta" data-inline-meta></div>

          <div class="detail__footer">
            <SiteFooter
              siblings={site.languages}
              socialLinks={site.socialLinks}
              atlasPdfUrl={site.atlasPdfUrl}
              languageVersionsUrl={site.languageVersionsUrl}
              footerLegal={site.footerLegal}
            />
          </div>
        </main>
      </div>
    </div>

    <div class="detail__spacer"></div>
  </div>
</Layout>

<style is:global>
  body { padding: 0; }
  /* Clip the hero's right full-bleed at the root instead of on .detail, so no
     ancestor of the sidebar has a non-visible overflow (which would break its
     position: sticky). overflow-y stays visible → the page still scrolls and
     the sticky sidebar references the viewport. */
  html { overflow-x: clip; }
</style>

<style>
  .detail {
    --top-clear: 79px; /* FancyBar 10 + compact nav 69 */
    /* Pin the sidebar exactly at its natural offset (col padding-top below),
       so it's fixed from the first scrolled pixel — no sticky "settle" travel.
       Flush with the nav (not +size-12) so the sidebar's own overflow clips
       scrolled-out content right at the nav edge, not below it; the visual
       48px breathing room instead lives as padding inside the scroll box. */
    --sticky-top: var(--top-clear);
    /* Distance from the centre column's edge to the viewport edge — i.e. the
       spacer width. Full-bleed pseudo-elements extend by exactly this instead
       of a whole -100vw (which would overflow ~a full viewport and, in touch
       mode, stretch the fixed nav + background layer past the visible edge). */
      --edge: max(var(--size-9), calc((100vw - 1280px) / 2));
    position: relative;
    display: flex;
    align-items: stretch;
    /* No overflow here: any non-visible overflow on an ancestor would break
       the sidebar's position: sticky. The hero's right bleed is clipped at
       the root instead (html { overflow-x: clip }). */
  }

  /* Fixed split background */
  .detail-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    display: flex;
    pointer-events: none;
  }
  /* min-width matches the nav's 36px side padding (--size-9) so the content
     column lines up with the navigation instead of sitting closer to the edge. */
  .detail-bg__fill { flex: 1 1 0; min-width: var(--size-9); }
  .detail-bg__fill--left { background: var(--blue-gray-200); }
  .detail-bg__fill--right { background: var(--blue-gray-100); }
  .detail-bg__center {
    flex: 0 1 1280px;
    min-width: 0;
    display: grid;
    grid-template-columns: 290px minmax(0, 1fr);
  }
  .detail-bg__col--sidebar { background: var(--blue-gray-200); }
  .detail-bg__col--content { background: var(--blue-gray-100); }

  .detail__spacer { flex: 1 1 0; min-width: var(--size-9); } /* matches nav padding */

  .detail__center {
    position: relative;
    z-index: 1;
    flex: 0 1 1280px;
    min-width: 0;
    display: flex;
  }
  .detail__main {
    flex: 1;
    display: grid;
    grid-template-columns: 290px minmax(0, 1fr);
    min-width: 0;
  }

  /* Sidebar meta panel */
  .detail__sidebar-col {
    padding: var(--sticky-top) 0 0 0;
  }
  .detail__sidebar-sticky {
    position: sticky;
    top: var(--sticky-top);
    /* Stay pinned while the content scrolls. Only if the panel itself is
       taller than the viewport does it scroll — and then only when the
       cursor is over it (that's where the scroll container lives). The
       right gap (36px) lives here, not on the column, so an overflow
       scrollbar rides the column's actual right edge instead of sitting
       inset by the gap. Top padding (48px) also lives here rather than in
       --sticky-top, so it's inside the clip boundary: scrolled-out content
       disappears flush with the nav instead of lingering in that gap. */
    padding: var(--size-12) var(--size-9) 0 0; /* top 48, right 36 */
    max-height: calc(100vh - var(--sticky-top) - var(--size-6));
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .meta {
    display: flex;
    flex-direction: column;
    gap: var(--size-10); /* 40px */
    align-items: flex-start;
  }
  .meta__block {
    display: flex;
    flex-direction: column;
    align-items: flex-start; /* button groups hug, source/related stretch */
    gap: var(--size-4); /* 16px */
    width: 100%;
  }
  /* Left-align the content inside the sidebar buttons. */
  .meta :global(.btn) { justify-content: flex-start; }
  .meta__label {
    margin: 0;
    color: var(--text-primary);
  }
  /* Underlying data: one source per row, icon on the left. The icon must not
     be pulled into the wrap of a multi-line name, hence flex +
     align-items:start and a non-shrinking icon. */
  .meta__sources {
    display: flex;
    flex-direction: column;
    align-self: stretch;
    gap: var(--size-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .meta__source-item a,
  .meta__source-plain {
    display: flex;
    align-items: flex-start;
    gap: var(--size-2);
    color: var(--text-secondary);
    text-decoration: none;
  }
  .meta__source-plain { color: var(--text-tertiary); }
  .meta__source-item a:hover { text-decoration: underline; }
  .meta__source-item :global(i) {
    flex: none;
    width: 1em;
    margin-top: 0.15em;
    text-align: center;
  }
  .meta__related-item {
    display: flex;
    flex-direction: column;
    gap: var(--size-4); /* 16px */
    width: 100%;
  }
  .meta__related {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    gap: var(--size-3);
  }

  /* Content */
  .detail__content { position: relative; min-width: 0; }

  .detail__hero {
    position: relative;
    z-index: 0;
    padding: calc(var(--top-clear) + var(--size-12)) 0 var(--size-16) var(--size-24);
  }
  /* White band that bleeds to the right viewport edge (clipped by .detail). */
  .detail__hero::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0 calc(-1 * var(--edge)) 0 0; /* bleed right, exactly to the edge */
    background: var(--white);
  }
  .detail__hero-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start; /* tag hugs its content instead of stretching */
    gap: var(--size-6); /* 24px */
    max-width: 894px;
  }
  .detail__back { margin-bottom: var(--size-1); /* 4px */ }
  .detail__back :global(.btn) { padding: 0; min-height: 0; }
  .detail__back :global(.btn__label) { padding: 0; }
  .detail__titles {
    display: flex;
    flex-direction: column;
    gap: var(--size-2); /* 8px */
    width: 100%;
  }
  .detail__title {
    margin: 0;
    color: var(--text-primary);
  }
  .detail__lead {
    margin: 0;
    color: var(--text-primary);
  }
  .detail__media {
    width: 100%;
    overflow: hidden;
    border-radius: var(--size-2);
  }

  .detail__body {
    display: flex;
    flex-direction: column;
    gap: var(--size-12); /* 48px */
    padding: var(--size-16) 0 var(--size-24) var(--size-24); /* top 64, left 96, bottom 96 */
    max-width: 894px;
  }

  .detail__footer { padding-left: var(--size-24); max-width: 894px; /* 96px inset + width cap, matches the hero/body */ }
  .detail__intro {
    margin: 0;
    color: var(--text-primary);
  }
  .detail__sections {
    display: flex;
    flex-direction: column;
    gap: var(--size-8); /* 32px */
    max-width: 600px;
  }
  .detail__section { display: flex; flex-direction: column; gap: var(--size-3); }
  .detail__section h2 {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 20px;
    line-height: 1.2;
    color: var(--text-primary);
  }
  .detail__section p {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 16px;
    line-height: 1.5;
    color: var(--text-primary);
  }
  .detail__section a {
    color: inherit;
    text-decoration: underline;
    text-underline-position: from-font;
  }
  .detail__section a:hover { color: var(--blue-600); }

  /* Rendered markdown body (from the CMS). */
  .detail__prose { max-width: 600px; overflow-wrap: break-word; }
  .detail__prose :global(h2) {
    margin: var(--size-8) 0 var(--size-3);
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 20px;
    line-height: 1.2;
    color: var(--text-primary);
  }
  .detail__prose :global(h2:first-child) { margin-top: 0; }
  .detail__prose :global(p) {
    margin: 0 0 var(--size-4);
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 16px;
    line-height: 1.5;
    color: var(--text-primary);
  }
  .detail__prose :global(ul),
  .detail__prose :global(ol) {
    margin: 0 0 var(--size-4);
    padding-left: var(--size-6);
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.5;
    color: var(--text-primary);
  }
  .detail__prose :global(li) { margin-bottom: var(--size-2); }
  .detail__prose :global(a) {
    color: inherit;
    text-decoration: underline;
    text-underline-position: from-font;
    overflow-wrap: anywhere;
  }

  /* GFM footnotes ([^1] in the Body): the marker renders as a superscript
     number; the auto-generated list lands here at the end. Note text and the
     numbers are monospaced blue. */
  .detail__prose :global(.footnotes) {
    margin-top: var(--size-10); /* 40px */
    padding-top: var(--size-4);
    border-top: 1px solid var(--gray-300);
  }
  /* GFM emits an accessible-only "Footnotes" heading — hide it visually. */
  .detail__prose :global(.footnotes h2.sr-only) {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  /* Superscript reference marker in the body — blue monospace, no underline. */
  .detail__prose :global([data-footnote-ref]) {
    font-family: var(--font-mono);
    text-decoration: underline;
  }
  /* Own numbering (via a counter) so the gap between the number and the note
     text is ours to size, not the browser's default marker spacing. */
  .detail__prose :global(.footnotes ol) {
    list-style: none;
    counter-reset: fn;
    margin: 0;
    padding-left: 0;
  }
  .detail__prose :global(.footnotes li) {
    counter-increment: fn;
    position: relative;
    padding-left: var(--size-10); /* number column + gap (40px) */
    margin-bottom: var(--size-2);
  }
  .detail__prose :global(.footnotes li)::before {
    content: counter(fn) '.';
    position: absolute;
    left: 0;
    font-family: var(--font-mono);
  }
  .detail__prose :global(.footnotes p) {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.5;
  }
  /* Land clear of the fixed nav when jumping to a note or back to its marker. */
  .detail__prose :global(.footnotes li),
  .detail__prose :global([data-footnote-ref]) {
    scroll-margin-top: calc(var(--top-clear) + var(--size-6));
  }

  /* Mount points for the relocated sidebar blocks — desktop keeps them empty
     and hidden; JS reveals + fills them at ≤ --bp-lg (see the <script>). */
  .detail__inline-meta,
  .detail__end-meta { display: none; }

  @media (max-width: 1280px) {
    .detail__hero {padding: calc(var(--top-clear) + var(--size-12)) 0 var(--size-9) var(--size-9);}
    .detail__body {padding: var(--size-9) 0 var(--size-12) var(--size-9);}
    .detail__footer {padding-left: var(--size-9);}
  }

  /* =====================================================================
     Small screens (≤ --bp-lg 1024): single column. The sidebar's Download +
     Underlying data blocks and More articles all move to the end of the
     article. See the <script>.
     ===================================================================== */
  @media (max-width: 1024px) {
    /* Uniform background — no sidebar tint band. */
    .detail-bg__center { grid-template-columns: 1fr; }
    .detail-bg__col--sidebar { display: none; }
    .detail-bg__fill--left { background: var(--blue-gray-100); }

    .detail__main { grid-template-columns: 1fr; }
    .detail__sidebar-col { display: none; }

    /* Single column: the 36px spacer is the ONLY side gutter (same as the
       nav), so hero + body drop their side padding — text lands at the same
       inset as the navigation. */
    .detail__hero { padding-left: 0; }
    .detail__body { padding-left: 0; }
    .detail__footer { padding-left: 0; }

    /* With no sidebar, the hero's white band bleeds to BOTH edges so there's
       no leftover blue-gray spacer strip beside it on the left. */
    .detail__hero::before {
      inset: 0 calc(-1 * var(--edge)) 0 calc(-1 * var(--edge));
    }

    /* Relocated Next/Previous infographic, at the end of the article —
       laid out as two side-by-side columns (Previous | Next). */
    .detail__end-meta {
      display: block;
    }
    .detail__end-meta .meta__block {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--size-6); /* 24px */
    }
    /* Source order is Next then Previous; swap so Next sits in the right
       column while the two-column layout holds. */
    .detail__end-meta .meta__related-item:first-child { order: 1; }

    /* Relocated Underlying data + Download, below Next/Previous — the last
       blocks, so they carry the bottom breathing room. */
    .detail__inline-meta {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--size-8); /* 32px */
      padding: var(--size-8) 0 var(--size-16); /* aligns with the nav via the spacer */
    }
    .detail__inline-meta .meta__block { min-width: 0; }
    .detail__inline-meta :global(.btn) { justify-content: flex-start; }
  }

  /* Large phone (--bp-xs 480): tighter edge gutter. */
  @media (max-width: 480px) {
    .detail {
      --edge: max(var(--size-4), calc((100vw - 1280px) / 2));
    }
    .detail-bg__fill,
    .detail__spacer { min-width: var(--size-4); } /* 36px -> 16px */

    /* top-clear + 16px breathing room, was +48px */
    .detail__hero { padding: calc(var(--top-clear) + var(--size-4)) 0 var(--size-4) 0; }
    .detail__body { padding-top: var(--size-4); padding-bottom: var(--size-4); }
    .detail__inline-meta {
      grid-template-columns: 1fr;
      padding-bottom: var(--size-4); /* 96px -> 16px */
    }
    .detail__end-meta .meta__block { grid-template-columns: 1fr; }
    /* Single column: restore reading order (Next first). */
    .detail__end-meta .meta__related-item:first-child { order: 0; }
    .detail__title { font-size: 26px; } /* 32px -> 26px */
    .detail__lead { font-size: 17px; } /* 20px -> 17px */
  }
</style>

<script>
  import '../scripts/detail-meta';
</script>
