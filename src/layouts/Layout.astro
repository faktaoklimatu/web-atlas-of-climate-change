---
import '@fontsource-variable/inter';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import '../styles/tokens.css';
import '../styles/typography.css';
import { ClientRouter } from 'astro:transitions';
import { absoluteUrl, truncate } from '../utils/seo';
import seo from '../data/seo.json';
import site from '../data/site.json';
import { ui } from '../data/ui';
import { deployConfig } from '../../public/deploy.config.js';

interface LanguageSibling {
  code: string;
  flag?: string;
  url: string;
  hreflang?: string;
}

interface Props {
  title: string;
  /** Plain text; truncated defensively to a safe meta-description length. */
  description?: string;
  /** Base-relative public path (e.g. from the CMS `image` field). Falls back to `seo.ogImageFallback`. */
  image?: string;
  /** og:type. */
  type?: 'website' | 'article';
  /** Defaults to the current URL. */
  canonicalPath?: string;
  /** Excludes the page from indexing (e.g. 404). */
  noindex?: boolean;
}

const {
  title,
  description,
  image,
  type = 'website',
  canonicalPath,
  noindex = false,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const lang = deployConfig.lang || 'en';

const canonicalUrl = absoluteUrl(Astro.site, canonicalPath ?? Astro.url.pathname);
const ogImage = absoluteUrl(Astro.site, `${base}${image ?? seo.ogImageFallback}`);
const metaDescription = truncate(description || seo.defaultDescription);
const languages = (site.languages as LanguageSibling[]).filter((l) => l.hreflang);
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="any" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    <meta name="theme-color" content="#1D4ED8" />
    <title>{title}</title>

    <meta name="description" content={metaDescription} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />
    {languages.map((l) => <link rel="alternate" hreflang={l.hreflang} href={l.url} />)}
    {languages.length > 0 && <link rel="alternate" hreflang="x-default" href={canonicalUrl} />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={seo.siteTitle} />
    <meta property="og:locale" content={lang} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Font Awesome (icons for the underlying-data list in the detail sidebar). -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
      integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />

    <ClientRouter />
  </head>
  <body>
    <a href="#main-content" class="skip-link">{ui.a11y.skipToContent}</a>
    <slot />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -100%;
    left: var(--size-4);
    z-index: 200;
    padding: var(--size-2) var(--size-4);
    background: var(--white);
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-weight: 600;
    text-decoration: none;
    border-radius: 0 0 var(--size-1-5) var(--size-1-5);
  }
  .skip-link:focus {
    top: 0;
  }
</style>
