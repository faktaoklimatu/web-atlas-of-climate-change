---
/**
 * Nav — Figma node 48:1351 ("Top Nav"), two variants:
 *   • Variant2 (hero, ~208px): 72px title + subtitle, shown on page load.
 *   • Default (compact, 69px): 24px title, shown after scrolling.
 * The bar is fixed; it collapses hero → compact on scroll (see <script>).
 * The FancyBar sits fixed above it. The globe opens a language switcher whose
 * entries come from `siblings` (later wired to the CMS sibling list).
 */
import GlobeIcon from './icons/GlobeIcon.astro';
import ListIcon from './icons/ListIcon.astro';
import CloseIcon from './icons/CloseIcon.astro';
import { ui } from '../data/ui';
import { pdfLinkAttrs } from '../utils/img';

interface Sibling {
  code: string;
  flag?: string;
  url: string;
}
interface Props {
  /** Language versions for the switcher (CMS: Settings → Navigation). */
  siblings?: Sibling[];
  brandHref?: string;
  /** Atlas PDF download (CMS: Settings → Navigation, via site.json); link hidden when empty. */
  atlasPdfUrl?: string;
  /** Start (and stay) in the compact bar — used on detail pages. */
  compact?: boolean;
  class?: string;
}

const {
  siblings = [],
  brandHref = import.meta.env.BASE_URL,
  atlasPdfUrl,
  compact = false,
  class: className,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const aboutHref = `${base}/about/`;
---

<header
  class:list={['nav', className]}
  data-nav
  data-compact={compact ? '' : undefined}
>
  <div class="nav__inner">
    <a class="nav__brand" href={brandHref}>
      <span class="nav__title">{ui.nav.title}</span>
      <span class="nav__subtitle">{ui.nav.subtitle}</span>
    </a>

    <nav class="nav__links" aria-label={ui.nav.primaryLabel}>
      <a class="nav__link type-nav-link" href={aboutHref}>{ui.nav.about}</a>

      {atlasPdfUrl && (
        <a
          class="nav__link type-nav-link"
          {...pdfLinkAttrs(atlasPdfUrl)}
        >{ui.nav.downloadPdf}</a>
      )}

      {siblings.length > 0 && (
      <div class="nav__lang" data-lang>
        <button
          type="button"
          class="nav__lang-toggle"
          aria-label={ui.nav.changeLanguage}
          aria-expanded="false"
          aria-haspopup="true"
          data-lang-toggle
        >
          <GlobeIcon size={20} />
        </button>

        <div class="nav__lang-menu">
          {
            siblings.map((s) => (
              <a class="nav__lang-item type-mono" href={s.url}>
                <span class="nav__lang-flag" aria-hidden="true">{s.flag}</span>
                <span class="nav__lang-code">{s.code}</span>
              </a>
            ))
          }
        </div>
      </div>
      )}
    </nav>

    <!-- Larger phones (≤ --bp-sm): the inline links collapse into this button,
         which opens the menu overlay below (same icon as the feed's Contents
         button). -->
    <button
      type="button"
      class="nav__menu-toggle"
      aria-label={ui.nav.menu}
      aria-expanded="false"
      aria-haspopup="true"
      data-navmenu-open
    >
      <ListIcon size={20} />
    </button>
  </div>

  <!-- Menu overlay (larger phones): bottom sheet mirroring the feed's TOC
       overlay. Holds About + Download and, if present, the languages listed
       directly (no globe). -->
  <div class="nav-overlay" data-navmenu-overlay hidden>
    <div class="nav-overlay__backdrop" data-navmenu-close></div>
    <div
      class="nav-overlay__panel"
      role="dialog"
      aria-modal="true"
      aria-label={ui.nav.menu}
      tabindex="-1"
      data-navmenu-panel
    >
      <div class="nav-overlay__header">
        <span class="nav-overlay__title type-eyebrow">{ui.nav.menu}</span>
        <button
          type="button"
          class="nav-overlay__close"
          data-navmenu-close
          aria-label={ui.nav.closeMenu}
        >
          <CloseIcon size={20} />
        </button>
      </div>
      <div class="nav-overlay__body">
        <nav class="nav-menu" aria-label={ui.nav.primaryLabel}>
          <a class="nav-menu__item type-nav-link" href={aboutHref}>{ui.nav.about}</a>
          {atlasPdfUrl && (
            <a
              class="nav-menu__item type-nav-link"
              {...pdfLinkAttrs(atlasPdfUrl)}
            >{ui.nav.downloadPdf}</a>
          )}
          {siblings.length > 0 && (
            <div class="nav-menu__langs">
              <span class="nav-menu__langs-label type-eyebrow">{ui.nav.languages}</span>
              {siblings.map((s) => (
                <a class="nav-menu__item nav-menu__lang type-mono" href={s.url}>
                  {s.flag && <span class="nav-menu__lang-flag" aria-hidden="true">{s.flag}</span>}
                  <span>{s.code}</span>
                </a>
              ))}
            </div>
          )}
        </nav>
      </div>
    </div>
  </div>
</header>

<style>
  .nav {
    /* 0 = hero, 1 = compact. Driven linearly from scroll (see <script>);
       every size below interpolates between the two states via this var. */
    --nav-progress: 0;
    position: fixed;
    top: var(--size-2-5); /* 10px — sits below the FancyBar */
    left: 0;
    right: 0;
    z-index: 90;
    display: flex;
    justify-content: center;
    /* block padding 48px (hero) → 20px (compact) */
    padding: calc(48px - 28px * var(--nav-progress)) var(--size-9);
    background: var(--blue-700); /* #1d4ed8 */
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--white);
  }

  /* Detail pages start (and stay) compact — no scroll wiring runs there. */
  .nav[data-compact] {
    --nav-progress: 1;
  }

  .nav__inner {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--size-8); /* 32px */
    width: 100%;
    max-width: 1280px;
  }

  .nav__brand {
    display: flex;
    flex-direction: column;
    /* row gap 6px → 0 so the collapsing subtitle leaves no empty gap */
    gap: calc(6px - 6px * var(--nav-progress));
    color: var(--white);
    text-decoration: none;
  }

  .nav__title {
    font-family: var(--font-sans);
    font-weight: 600;
    /* 72px (hero) → 24px (compact) */
    font-size: calc(72px - 48px * var(--nav-progress));
    line-height: 1.2;
    /* -2.88px → -0.48px */
    letter-spacing: calc(-2.88px + 2.4px * var(--nav-progress));
    white-space: nowrap;
    /* The oversized hero title must not dictate nav__inner's intrinsic width —
       otherwise on narrower desktops it pushes nav__links past the viewport
       edge. Zero layout width + visible overflow lets it spill to the right,
       past nav__brand, over the gap toward (but under) the links. Height is
       unaffected (line-box height still tracks font-size), so the hero bar and
       its scroll-shrink are unchanged. At ≤ --bp-lg the wrapping compact bar
       restores auto width. Works because flex items honour an explicit width. */
    width: 0;
    overflow: visible;
  }

  .nav__subtitle {
    max-width: 680px;
    overflow: hidden;
    /* 40px → 0 */
    max-height: calc(40px - 40px * var(--nav-progress));
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 18px;
    line-height: 1.1;
    letter-spacing: -0.36px;
    color: #f3f3f3;
    opacity: calc(1 - var(--nav-progress));
  }

  .nav__links {
    display: flex;
    align-items: flex-end;
    gap: var(--size-8); /* 32px */
    flex: none;
  }

  .nav__link {
    color: var(--white);
    text-decoration: none;
    white-space: nowrap;
  }
  .nav__link:hover { text-decoration: underline; }

  /* --- Language switcher --- */
  .nav__lang {
    position: relative;
    display: flex;
  }

  .nav__lang-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--size-6); /* 24px */
    height: var(--size-6);
    padding: 0;
    border: 0;
    background: none;
    color: var(--white);
    cursor: pointer;
    border-radius: var(--size-1);
  }
  .nav__lang-toggle:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.5);
  }

  .nav__lang-menu {
    position: absolute;
    top: calc(100% + var(--size-2)); /* 8px below */
    right: 0;
    display: none;
    flex-direction: column;
    min-width: 72px;
    background: var(--white);
    border: 1px solid var(--gray-300);
    border-radius: var(--size-1-5); /* 6px */
    overflow: hidden;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.12);
  }
  .nav.is-lang-open .nav__lang-menu { display: flex; }

  .nav__lang-item {
    display: flex;
    align-items: center;
    gap: var(--size-0-5); /* 2px */
    min-height: var(--size-9); /* 36px */
    padding: var(--size-1-5) var(--size-3); /* 6px 12px */
    color: var(--text-primary);
    text-decoration: none;
  }
  .nav__lang-item + .nav__lang-item { border-top: 1px solid var(--gray-300); }
  .nav__lang-item:hover { background: var(--gray-50); }
  .nav__lang-flag { font-size: 14px; }
  .nav__lang-code { padding: 0 var(--size-1); }

  /* --- Menu overlay (large phones) --- Hidden above --bp-xs; the toggle and
     overlay only take over from the inline links at ≤ 480 (see that query). */
  .nav__menu-toggle {
    display: none; /* shown ≤ --bp-xs */
    align-items: center;
    justify-content: center;
    width: var(--size-6); /* 24px */
    height: var(--size-6);
    padding: 0;
    border: 0;
    background: none;
    color: var(--white);
    cursor: pointer;
    border-radius: var(--size-1);
  }
  .nav__menu-toggle :global(svg) { display: block; }
  .nav__menu-toggle:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.5);
  }

  .nav-overlay[hidden] { display: none; }
  .nav-overlay { position: fixed; inset: 0; z-index: 95; }
  .nav-overlay__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.4);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .nav-overlay.is-open .nav-overlay__backdrop { opacity: 1; }
  .nav-overlay__panel {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    max-height: calc(100dvh - 84px); /* keep the fixed nav visible */
    display: flex;
    flex-direction: column;
    background: var(--blue-gray-200);
    border-top-left-radius: var(--size-4);
    border-top-right-radius: var(--size-4);
    box-shadow: 0 -8px 24px rgba(15, 23, 42, 0.18);
    transform: translateY(100%);
    transition: transform 0.34s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .nav-overlay.is-open .nav-overlay__panel { transform: translateY(0); }
  .nav-overlay__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--size-4);
    padding: var(--size-4) var(--size-5);
    border-bottom: 1px solid var(--blue-gray-300);
  }
  .nav-overlay__title { margin: 0; color: var(--text-primary); }
  .nav-overlay__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--size-9);
    height: var(--size-9);
    padding: 0;
    border: 0;
    background: none;
    color: var(--text-primary);
    cursor: pointer;
    border-radius: var(--size-1);
  }
  .nav-overlay__close:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--blue-600);
  }
  .nav-overlay__body {
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--size-5);
  }

  .nav-menu {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--size-3); /* 12px */
  }
  .nav-menu__item {
    color: var(--text-primary);
    text-decoration: none;
  }
  .nav-menu__item:hover { text-decoration: underline; }
  .nav-menu__langs {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--size-2); /* 8px */
    margin-top: var(--size-2);
    padding-top: var(--size-3);
    border-top: 1px solid var(--blue-gray-300);
  }
  .nav-menu__langs-label { margin: 0 0 var(--size-1); color: var(--text-secondary); }
  .nav-menu__lang {
    display: flex;
    align-items: center;
    gap: var(--size-1-5); /* 6px */
  }
  .nav-menu__lang-flag { font-size: 14px; }

  @media (prefers-reduced-motion: reduce) {
    .nav-overlay__panel,
    .nav-overlay__backdrop { transition: none; }
  }

  /* --- Small screens: fixed compact bar (--bp-lg 1024) ---
     The bar stops interpolating with scroll and keeps one small height. The
     subtitle joins the title on the same line in regular weight. Literal font
     sizes below win over the base calc()s regardless of --nav-progress, so the
     feed's scroll wiring can keep running harmlessly. */
  @media (max-width: 1024px) {
    .nav {
      /* fixed small height — no more hero → compact travel; side padding
         stays at the page gutter (--size-9 = 36) like every other section */
      padding: var(--size-3) var(--size-9); /* 12px 36px */
    }
    .nav__inner {
      align-items: center;
      gap: var(--size-2) var(--size-4);
      flex-wrap: wrap;
      min-width: 0;
    }
    .nav__brand {
      flex-direction: row;
      align-items: baseline;
      flex-wrap: wrap;
      min-width: 0;
      gap: var(--size-2);
    }
    .nav__title {
      font-size: var(--size-5);
      letter-spacing: -0.4px;
      white-space: normal;
      width: auto; /* small enough to size normally in the wrapping bar */
    }
    .nav__subtitle {
      display: none;
    }
    .nav__links {
      align-items: center;
      gap: var(--size-6); /* 32px -> 24px */
    }
  }

  /* Larger phones (--bp-sm 640): the inline links collapse into the menu
     overlay, opened from the single menu button. */
  @media (max-width: 640px) {
    .nav__links { display: none; }
    .nav__menu-toggle { display: inline-flex; }
  }

  /* Large phone (--bp-xs 480): same tighter edge gutter as the rest of the
     page (36px -> 16px), and the title drops to the same size as the menu
     button beside it. */
  @media (max-width: 480px) {
    .nav { padding: var(--size-3) var(--size-4); }
    .nav__title { font-size: 15px; letter-spacing: 0; } /* matches .nav__link (type-nav-link) */
  }
</style>

<style is:global>
  /* Scroll lock while the nav menu overlay is open — only the overlay scrolls.
     Global because Nav renders on every page (the feed's own lock is scoped
     to its page). */
  html.is-nav-menu-locked,
  html.is-nav-menu-locked body { overflow: hidden; }
</style>

<script>
  import '../scripts/nav';
  import '../scripts/nav-menu';
</script>
