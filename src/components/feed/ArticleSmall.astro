---
/**
 * ArticleSmall — grid-view card. Figma: Section/Grid → ArticleSmall (135:4558).
 * Same bordered/gradient container as ArticleCard (list view), scaled down —
 * smaller padding, same title size. Grid stretches every card in a row to the
 * tallest (default CSS Grid align-items), and the link's space-between keeps
 * the graphic pinned to the bottom regardless of title length.
 */
interface Props {
  title: string;
  image: string;
  slug: string;
  chapterId: string;
  href?: string;
}
import { imgUrl } from '../../utils/img';
import CroppedInfographic from '../CroppedInfographic.astro';
const { title, image, slug, chapterId, href = '#' } = Astro.props;
const src = imgUrl(image);
---

<article class="scard" data-slug={slug} data-chapter={chapterId}>
  <a class="scard__link" href={href}>
    <h3 class="scard__title type-card-title">{title}</h3>
    <CroppedInfographic src={src} alt="" />
  </a>
</article>

<style>
  .scard {
    scroll-margin-top: 110px;
    height: 100%;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--gray-300);
    border-radius: var(--size-2); /* 8px */
    overflow: hidden;
    background: linear-gradient(to bottom, var(--blue-gray-100) 0%, var(--white) 15%);
  }
  .scard__link {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--size-3); /* 12px */
    height: 100%;
    padding: var(--size-2) var(--size-3) 0; /* 12px 12px 0 */
    text-decoration: none;
  }
  .scard__title {
    margin: 0;
    color: var(--text-primary);
  }
  /* Hover (pointer devices only — never sticks on touch). */
  @media (hover: hover) {
    .scard {
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .scard:has(.scard__link:hover) {
      border-color: var(--gray-400);
      box-shadow: 0 6px 16px rgba(15, 23, 42, 0.1);
    }
  }

  /* Large phone (--bp-xs 480): tighter card padding/gap. */
  @media (max-width: 480px) {
    .scard__link { gap: var(--size-2); padding: var(--size-1-5) var(--size-2) 0; }
  }
</style>
