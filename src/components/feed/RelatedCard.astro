---
/**
 * RelatedCard — Previous/Next infographic card in the detail sidebar.
 * Same bordered/gradient container + crop as the homepage grid's
 * ArticleSmall, so previews look identical wherever they appear.
 */
interface Props {
  title: string;
  image: string;
  href: string;
}
import { imgUrl } from '../../utils/img';
import CroppedInfographic from '../CroppedInfographic.astro';
const { title, image, href } = Astro.props;
const src = imgUrl(image);
---

<a class="related" href={href}>
  <h3 class="related__title type-card-title">{title}</h3>
  <CroppedInfographic src={src} alt="" />
</a>

<style>
  .related {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--size-3); /* 12px */
    border: 1px solid var(--gray-300);
    border-radius: var(--size-2); /* 8px */
    overflow: hidden;
    background: linear-gradient(to bottom, var(--blue-gray-100) 0%, var(--white) 15%);
    padding: var(--size-2) var(--size-3) 0; /* 12px 12px 0 */
    text-decoration: none;
  }
  .related__title {
    margin: 0;
    color: var(--text-primary);
  }
  @media (hover: hover) {
    .related { transition: border-color 0.2s ease, box-shadow 0.2s ease; }
    .related:hover {
      border-color: var(--gray-400);
      box-shadow: 0 6px 16px rgba(15, 23, 42, 0.1);
    }
  }
</style>
