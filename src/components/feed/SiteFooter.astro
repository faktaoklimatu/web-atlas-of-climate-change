---
/**
 * SiteFooter — Figma: footer of the grid page (117:1203).
 * Atlas title + PDF download, then social links; a language switcher +
 * "get it in your language" link, then copyright. Sits inside the content
 * column, below the feed.
 */
import ButtonGroup from '../ButtonGroup.astro';
import Button from '../Button.astro';
import { imgUrl, pdfLinkAttrs } from '../../utils/img';
import { renderInlineMarkdown } from '../../utils/markdown';
import { ui } from '../../data/ui';
import seo from '../../data/seo.json';
import { deployConfig } from '../../../public/deploy.config.js';

interface Sibling {
  code: string;
  flag?: string;
  url: string;
}
interface SocialLink {
  label: string;
  url: string;
  icon: string;
}
interface Props {
  /** Language versions from the CMS (Settings → Navigation, via site.json). */
  siblings?: Sibling[];
  /** Social icon links from the CMS (Settings → Navigation, via site.json). */
  socialLinks?: SocialLink[];
  /** Atlas PDF download from the CMS; hidden when empty. */
  atlasPdfUrl?: string;
  /** "Get the Atlas in your language" link target; hidden when empty. */
  languageVersionsUrl?: string;
  /** Copyright/license/contact — a single CMS-edited paragraph. */
  footerLegal?: string;
}
const {
  siblings = [],
  socialLinks = [],
  atlasPdfUrl,
  languageVersionsUrl,
  footerLegal,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// English fork: "Get the Atlas in your language" points at the internal page
// (src/pages/get-the-atlas-in-your-language/). Every other fork keeps the
// external languageVersionsUrl from the CMS, hidden when it's blank.
const isEnglishFork = (deployConfig.lang || 'en') === 'en';
const languageHref = isEnglishFork
  ? `${base}/get-the-atlas-in-your-language/`
  : languageVersionsUrl;

const legalHtml = await renderInlineMarkdown(footerLegal);
---

<footer class="footer">
  <div class="footer__col">
    <div class="footer__brand">
      <a
        class="footer__logo"
        href="https://faktaoklimatu.cz/"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          src={`${base}/images/logo-fakta-o-klimatu.svg`}
          alt="Fakta o klimatu"
          width="220"
          height="32"
        />
      </a>
    </div>

    <div class="footer__social">
      <p class="footer__label">{ui.footer.followUs}</p>
      <div class="footer__icons">
        {
          socialLinks.map((s) => (
            <a href={s.url} aria-label={s.label} target="_blank" rel="noopener noreferrer">
              <img src={imgUrl(s.icon)} alt="" width="22" height="22" />
            </a>
          ))
        }
      </div>
    </div>

    <div class="footer__legal">
      <p class="footer__label" set:html={legalHtml}></p>
    </div>
  </div>

  <div class="footer__col">
    <div class="footer__download">
      <p class="footer__label">{seo.siteTitle}</p>
      {atlasPdfUrl && (
        <Button variant="outlined" {...pdfLinkAttrs(atlasPdfUrl)}>
          {ui.footer.downloadPdf}
        </Button>
      )}
    </div>

    {/* Whole block disappears when there is nothing to put in it: a fork with no
        `languages` and a blank languageVersionsUrl would otherwise contribute an
        empty column entry. */}
    {(siblings.length > 0 || languageHref) && (
      <div class="footer__languages">
        {/* Label + switcher only when there are siblings — an empty `languages`
            list would otherwise leave the heading stranded above nothing. The
            nav already guards this the same way. */}
        {siblings.length > 0 && (
          <Fragment>
            <p class="footer__label">{ui.footer.languageLabel}</p>
            <ButtonGroup role="group" aria-label={ui.footer.languageLabel}>
              {
                siblings.map((s) => (
                  <Button variant="text" href={s.url} target="_blank" rel="noopener noreferrer">
                    {s.flag && <span slot="icon-left" aria-hidden="true">{s.flag}</span>}
                    {s.code}
                  </Button>
                ))
              }
            </ButtonGroup>
          </Fragment>
        )}
        {languageHref && (
          <p class="footer__lang-intro">{ui.footer.languageInterest}</p>
        )}
        {languageHref && (
          <div class="footer__lang-link">
            <Button
              variant="text"
              href={languageHref}
              target={isEnglishFork ? undefined : '_blank'}
              rel={isEnglishFork ? undefined : 'noopener noreferrer'}
            >
              {ui.footer.getInYourLanguage}
            </Button>
          </div>
        )}
      </div>
    )}
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--size-16); /* 64px */
    padding: var(--size-10) 0; /* 40px */
    border-top: 1px solid var(--gray-200);
    font-family: var(--font-sans);
    color: var(--text-secondary);
    /* Two independent columns, not a 2-column grid. A grid row takes the
       height of its tallest cell, so the tall language block stranded ~260px
       of empty space beside the social icons. Each column now packs its own
       blocks and neither affects the other's height. */
    display: flex;
    align-items: flex-start;
    gap: var(--size-8); /* 32px */
  }
  .footer__col {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--size-6); /* 24px between blocks within a column */
  }

  /* Phones: one stack. `display: contents` dissolves the two columns so every
     block becomes a direct child of .footer in DOM order — which would put the
     legal line mid-stack, since it lives in column 1. `order` sends it last. */
  @media (max-width: 640px) {
    .footer { flex-direction: column; gap: var(--size-6); }
    .footer__col { display: contents; }
    .footer__legal { order: 1; }
  }

  /* Large phone (--bp-xs 480): tighter gap above the footer, matching the
     side gutter (was 64px). */
  @media (max-width: 480px) {
    .footer { margin-top: var(--size-4); }
  }


  .footer__label {
    margin: 0 0 var(--size-3);
    font-size: 15px;
    color: var(--text-secondary);
  }
  /* Publisher mark. Swap the file in public/images/ — the markup and the
     dimensions stay as they are. */
  .footer__logo { display: block; }
  .footer__logo img { display: block; width: auto; height: 90px; }

  .footer__download {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .footer__icons { display: flex; gap: var(--size-3); }
  .footer__icons a { display: inline-flex; }
  .footer__icons img { display: block; width: 22px; height: 22px; }
  @media (hover: hover) {
    .footer__icons a { transition: opacity 0.15s ease; }
    .footer__icons a:hover { opacity: 0.7; }
  }

  .footer__languages { display: flex; flex-direction: column; align-items: flex-start; }
  /* Blank line between the switcher and the invitation below it. Falls back to
     0 when the switcher is absent, so the invitation doesn't float off the top
     of an otherwise empty cell. */
  .footer__lang-intro {
    margin: var(--size-6) 0 0; /* 24px */
    font-size: 15px;
    color: var(--text-secondary);
  }
  .footer__languages > .footer__lang-intro:first-child { margin-top: 0; }
  .footer__lang-link { margin-top: var(--size-1); /* 4px */ }
  .footer__lang-link :global(.btn) { padding: 0; min-height: 0; }
  .footer__lang-link :global(.btn__label) { padding: 0; }

  .footer__legal { text-align: left; }
  .footer__legal .footer__label { margin: 0; }
  .footer__legal :global(a) { color: inherit; text-decoration: underline; }
</style>
