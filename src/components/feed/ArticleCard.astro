---
/**
 * ArticleCard — list-view card. Figma: Section/Column → Article (129:1284).
 * Bordered rounded card with a subtle top gradient, centred text block
 * (title 24px SemiBold + lead 16px, max 800px), then a full-width cropped graphic.
 */
interface Props {
  title: string;
  lead: string;
  image: string;
  slug: string;
  chapterId: string;
  href?: string;
}
import { imgUrl } from '../../utils/img';
import CroppedInfographic from '../CroppedInfographic.astro';
const { title, lead, image, slug, chapterId, href = '#' } = Astro.props;
const src = imgUrl(image);
---

<article class="acard" data-slug={slug} data-chapter={chapterId}>
  <a class="acard__link" href={href}>
    <div class="acard__text">
      <h3 class="acard__title type-heading">{title}</h3>
      <p class="acard__lead type-body">{lead}</p>
    </div>
    <div class="acard__media">
      <CroppedInfographic src={src} alt="" rounded />
    </div>
  </a>
</article>

<style>
  .acard {
    scroll-margin-top: 110px;
    display: block;
    border: 1px solid var(--gray-300);
    border-radius: var(--size-2); /* 8px */
    overflow: hidden;
    background: linear-gradient(to bottom, var(--blue-gray-100) 0%, var(--white) 15%);
  }

  .acard__link {
    display: flex;
    flex-direction: column;
    gap: var(--size-6); /* 24px */
    text-decoration: none;
  }

  .acard__text {
    display: flex;
    flex-direction: column;
    gap: var(--size-1); /* 4px */
    max-width: 800px;
    padding: var(--size-4) var(--size-6) 0; /* 20px 24px 0 */
  }
  .acard__title {
    margin: 0;
    color: var(--text-primary);
  }
  .acard__lead {
    margin: 0;
    color: var(--text-primary);
  }

  /* Same horizontal inset as .acard__text above it. */
  .acard__media {
    display: block;
    width: 100%;
    padding: 0 var(--size-6) var(--size-6); /* 0 24px 24px */
  }

  /* Hover (pointer devices only — never sticks on touch). */
  @media (hover: hover) {
    .acard {
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .acard:hover {
      border-color: var(--gray-400);
      box-shadow: 0 6px 20px rgba(15, 23, 42, 0.1);
    }
  }

  /* Large phone (--bp-xs 480): tighter card padding/gap. */
  @media (max-width: 480px) {
    .acard__link { gap: var(--size-4); } /* 24px -> 16px */
    .acard__text { padding: var(--size-3) var(--size-4) 0; } /* 20/24 -> 16 */
    .acard__media { padding: 0 var(--size-4) var(--size-4); } /* 24 -> 16 */
    .acard__title { font-size: 20px; } /* type-heading 24px -> 20px */
  }
</style>
